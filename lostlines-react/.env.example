# Copy this file to .env.local (or .env) for local development.
# Vite reads it automatically. Do not commit the copy.

# ⚠️ SECURITY
# VITE_* variables are baked into the frontend build and are visible in the
# browser. NEVER put JWT_SECRET, MONGO_URI, database passwords or private
# API keys in this file or in any frontend environment variable.

# Development default — matches the fallback inside src/api/api.js
VITE_API_URL=http://localhost:5000

# Production example (set in the hosting dashboard, e.g. Vercel):
# VITE_API_URL=https://your-backend-url.com